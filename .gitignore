# Default deny. Only the reviewed generic code, tests and docs below are allowed.
/*
!/.gitignore
!/README.md
!/SECURITY.md
!/RESTORE.md
!/LICENSE
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml
!/watcher.py
!/vulnerabilities.py
!/enrichment.py
!/SAMPLE_OUTPUT.md
!/docs/
/docs/*
!/docs/sample-report.png
!/public_feeds.py
!/secure_store.py
!/inventory.py
!/daily_check.py
!/fedora_advisories.py
!/hermes_send.py
!/notifications.py
!/watchlist.example.json
!/tests/
/tests/*
!/tests/test_watcher.py
!/tests/test_transport.py
!/tests/test_adapters.py
!/tests/test_security.py
!/tests/test_vulnerabilities.py
!/tests/test_enrichment.py
!/tests/test_public_feeds.py
!/tests/synthetic_encryption.py
!/tests/test_inventory.py
!/tests/test_daily_check.py
!/tests/test_secure_store.py
!/tests/test_fedora_advisories.py
!/tests/test_notifications.py
!/tests/test_export_defaults.py
!/tests/run_offline.py
!/tests/generate_sample.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/SYNTHETIC_osv.json
!/deploy/
/deploy/*
!/deploy/software-watcher.service.in
!/deploy/software-watcher.timer.in

# Defense in depth; do not override these with broad negations or force-adds.
**/.env
**/.env.*
**/.git/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/node_modules/
**/credentials/
**/secrets/
**/inventory/
**/state/
**/snapshots/
**/reports/
**/backups/
**/logs/
**/cache/
**/*.log
**/*.db
**/*.sqlite*
**/*.gpg
**/*.asc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.zip
**/*.tar*
**/*~
**/*.bak
